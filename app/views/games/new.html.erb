<div class="container text-center mt-5">
  <h1 class="mb-4">Longest Word Game</h1>

  <p class="text-muted">
    How many words can you make from these letters?
  </p>

  <div class="letter-grid mb-4">
    <% @letters.each do |letter| %>
      <div class="letter-card">
        <%= letter.upcase %>
      </div>
    <% end %>
  </div>

  <div class="card shadow-sm p-4 mx-auto game-card">
    <form action="/score" method="post" data-turbo="false">
      <label for="word" class="form-label">
        What's your longest word?
      </label>

      <input type="text"
             id="word"
             name="word"
             class="form-control mb-3"
             placeholder="Enter your word...">

      <%= hidden_field_tag :grid, @letters.join %>
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

      <input type="submit" value="Submit" class="btn btn-primary w-100">
    </form>
  </div>
</div>
